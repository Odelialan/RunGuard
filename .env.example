RUNGUARD_DATABASE_PATH=.data/runguard.db
RUNGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUNGUARD_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+)(:\d+)?$
RUNGUARD_EXECUTION_MODE=simulation
RUNGUARD_PROMPT_VERSION=1.0.0
RUNGUARD_POLICY_VERSION=1.0.0

# Optional external integrations. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
PROMETHEUS_URL=
LOKI_URL=
KUBERNETES_CONTEXT=
GITHUB_TOKEN=
