RUNGUARD_DATABASE_PATH=.data/runguard.db
RUNGUARD_PROJECT_ROOT=
RUNGUARD_DATABASE_URL=
RUNGUARD_DATABASE_SEED=true
RUNGUARD_DATABASE_POOL_MIN_SIZE=2
