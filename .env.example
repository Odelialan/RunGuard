RUNGUARD_KUBERNETES_SERVICE_ACCOUNT=runguard-executor
RUNGUARD_KUBERNETES_JOB_TIMEOUT_SECONDS=180
RUNGUARD_VERIFICATION_URL_TEMPLATE=
RUNGUARD_AGENT_BACKEND=deterministic
RUNGUARD_PROMPT_DIR=
RUNGUARD_LLM_MODEL=gpt-5-mini
RUNGUARD_LLM_BASE_URL=
RUNGUARD_EMBEDDINGS_ENABLED=false
RUNGUARD_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
