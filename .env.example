RUNGUARD_DATABASE_PATH=.data/runguard.db
RUNGUARD_PROJECT_ROOT=
RUNGUARD_DATABASE_URL=
RUNGUARD_DATABASE_SEED=true
RUNGUARD_VECTOR_DIMENSIONS=1536
RUNGUARD_REDIS_URL=
RUNGUARD_REDIS_STREAM=runguard.incident-events
RUNGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUNGUARD_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+)(:\d+)?$
RUNGUARD_ENVIRONMENT=development
RUNGUARD_EXECUTION_MODE=simulation
RUNGUARD_CONNECTOR_MODE=mock
RUNGUARD_PROMETHEUS_URL=
RUNGUARD_PROMETHEUS_TOKEN=
RUNGUARD_LOKI_URL=
RUNGUARD_LOKI_TOKEN=
RUNGUARD_GITHUB_REPOSITORY=
RUNGUARD_GITHUB_TOKEN=
RUNGUARD_KUBERNETES_CONTEXT=
RUNGUARD_KUBERNETES_NAMESPACE=runguard-system
RUNGUARD_KUBERNETES_RUNNER_IMAGE=ghcr.io/odelialan/runguard-runner:1.1.0
RUNGUARD_KUBERNETES_SERVICE_ACCOUNT=runguard-executor
RUNGUARD_KUBERNETES_JOB_TIMEOUT_SECONDS=180
RUNGUARD_VERIFICATION_URL_TEMPLATE=
RUNGUARD_AGENT_BACKEND=deterministic
RUNGUARD_PROMPT_DIR=
RUNGUARD_LLM_MODEL=gpt-5-mini
RUNGUARD_LLM_BASE_URL=
RUNGUARD_EMBEDDINGS_ENABLED=false
RUNGUARD_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
RUNGUARD_POLICY_BACKEND=python
RUNGUARD_OPA_URL=
RUNGUARD_OPA_FAIL_CLOSED=true
RUNGUARD_OTEL_EXPORTER_OTLP_ENDPOINT=
RUNGUARD_OTEL_SERVICE_NAME=runguard-api
RUNGUARD_A2A_REVIEWER_URL=
RUNGUARD_A2A_REVIEWER_TOKEN=
RUNGUARD_PROMPT_VERSION=1.1.0
RUNGUARD_POLICY_VERSION=1.1.0

# Optional external integrations. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
PROMETHEUS_URL=
LOKI_URL=
KUBERNETES_CONTEXT=
GITHUB_TOKEN=
